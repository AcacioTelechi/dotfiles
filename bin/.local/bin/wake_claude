#!/usr/bin/env bash
# wake_claude — keep a `claude remote-control` server always on, as a
# systemd --user service that runs it inside a detached tmux session.
#
# Each daemon gets its own tmux socket (-L claude-rc-<name>) so the tmux
# server lives in the service's cgroup: systemd tracks it, restarts it if
# claude exits, and it never collides with your interactive tmux server.
# Managed via GNU Stow (dotfiles/bin) -> ~/.local/bin/wake_claude
set -euo pipefail

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
PREFIX="claude-rc"

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'USAGE'
Usage: wake_claude [command] [options] [-- extra claude remote-control args]

Commands:
  up       (default) install + enable + start the daemon
  down     stop + disable the daemon and remove its unit file
  restart  restart the daemon
  status   systemctl status of the daemon
  logs     follow the daemon's journal
  attach   attach to the daemon's tmux session (detach: prefix + d)
  list     list installed claude-rc daemons

Options:
  -d, --dir DIR   directory to serve (default: current directory)
  -n, --name NAME daemon name (default: basename of DIR); also the
                  session name shown in claude.ai/code
  -h, --help      show this help

Examples:
  wake_claude                                  # serve $PWD
  wake_claude up -d ~/src/app -- --spawn worktree --permission-mode acceptEdits
  wake_claude attach -n app
  wake_claude down -n app
USAGE
}

# sanitize NAME -> safe for unit names and tmux session/socket names
sanitize() { printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '-' | sed 's/^-*//; s/-*$//'; }

# systemd-quote ARGS... -> one string safe for an ExecStart= line
sd_quote() {
  local out="" a
  for a in "$@"; do
    a="${a//\\/\\\\}"; a="${a//\"/\\\"}"; a="${a//%/%%}"; a="${a//\$/\$\$}"
    out+="${out:+ }\"$a\""
  done
  printf '%s' "$out"
}

# render_unit NAME DIR CLAUDE TMUX [extra claude args...] -> unit file on stdout
render_unit() {
  local name="$1" dir="$2" claude="$3" tmux="$4"; shift 4
  local sock="$PREFIX-$name"
  # tmux runs the inner command through /bin/sh, so shell-quote it once
  # (printf %q), then systemd-quote the whole tmux argv.
  local inner
  inner="$(printf '%q ' "$claude" remote-control --name "$name" "$@")"
  cat <<UNIT
# Generated by wake_claude — edit via \`wake_claude up\`, not by hand.
[Unit]
Description=Claude Code Remote Control ($name)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
WorkingDirectory=${dir//%/%%}
# WAKE_CLAUDE=1 lets tmux.conf turn off tmux-continuum for this server.
Environment=WAKE_CLAUDE=1
Environment=$(sd_quote "PATH=$(dirname "$claude"):/usr/local/bin:/usr/bin:/bin")
ExecStart=$(sd_quote "$tmux" -L "$sock" new-session -d -s "$name" -x 200 -y 50 "${inner% }")
ExecStop=$(sd_quote "$tmux" -L "$sock" kill-server)
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
UNIT
}

# is_trusted DIR -> 0 if claude's folder-trust dialog was accepted for DIR
is_trusted() {
  local cfg="$HOME/.claude.json"
  [ -f "$cfg" ] || return 1
  if have jq; then
    jq -e --arg d "$1" '.projects[$d].hasTrustDialogAccepted == true' "$cfg" >/dev/null 2>&1
  elif have python3; then
    python3 -I -c 'import json,sys; p=json.load(open(sys.argv[1])).get("projects",{}).get(sys.argv[2],{}); sys.exit(0 if p.get("hasTrustDialogAccepted") else 1)' "$cfg" "$1"
  else
    return 2  # can't tell
  fi
}

ensure_linger() {
  have loginctl || return 0
  [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" = "yes" ] && return 0
  log "enabling linger so the daemon runs while you're logged out and at boot"
  loginctl enable-linger "$USER" 2>/dev/null \
    || sudo loginctl enable-linger "$USER" \
    || warn "could not enable linger; the daemon will stop when you log out"
}

cmd_up() {
  have systemctl || die "systemd not found (wake_claude is Linux/systemd only)"
  local tmux claude rc
  tmux="$(command -v tmux)"     || die "tmux not installed"
  claude="$(command -v claude)" || die "claude not on PATH"
  [ -d "$DIR" ] || die "no such directory: $DIR"

  rc=0; is_trusted "$DIR" || rc=$?
  case "$rc" in
    0) ;;
    2) warn "can't verify folder trust (no jq/python3); if the daemon idles, run \`claude\` once in $DIR" ;;
    *) die "$DIR isn't trusted by claude yet — run \`claude\` there once and accept the prompt" ;;
  esac

  mkdir -p "$UNIT_DIR"
  render_unit "$NAME" "$DIR" "$claude" "$tmux" "${EXTRA[@]}" > "$UNIT_DIR/$UNIT"
  log "wrote $UNIT_DIR/$UNIT"
  ensure_linger
  systemctl --user daemon-reload
  systemctl --user enable "$UNIT" >/dev/null
  systemctl --user restart "$UNIT"
  log "$UNIT running — connect from claude.ai/code or the Claude app (session: $NAME)"
  log "peek: wake_claude attach -n $NAME   logs: wake_claude logs -n $NAME"
}

cmd_down() {
  systemctl --user disable --now "$UNIT" 2>/dev/null || true
  rm -f "$UNIT_DIR/$UNIT"
  systemctl --user daemon-reload
  log "removed $UNIT"
}

cmd_attach() {
  exec tmux -L "$PREFIX-$NAME" attach -t "$NAME"
}

cmd_list() {
  systemctl --user list-units --all --no-legend "$PREFIX-*.service" 2>/dev/null || true
}

main() {
  local cmd="up"
  case "${1:-}" in
    up|down|restart|status|logs|attach|list) cmd="$1"; shift ;;
  esac
  DIR="$PWD"; NAME=""; EXTRA=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -d|--dir)  DIR="${2:?--dir needs a value}"; shift ;;
      -n|--name) NAME="${2:?--name needs a value}"; shift ;;
      -h|--help) usage; exit 0 ;;
      --) shift; EXTRA=("$@"); break ;;
      *) die "unknown argument: $1 (try --help)" ;;
    esac
    shift
  done
  DIR="$(cd "$DIR" 2>/dev/null && pwd)" || die "no such directory"
  NAME="$(sanitize "${NAME:-$(basename "$DIR")}")"
  [ -n "$NAME" ] || die "empty daemon name"
  UNIT="$PREFIX-$NAME.service"

  case "$cmd" in
    up)      cmd_up ;;
    down)    cmd_down ;;
    restart) systemctl --user restart "$UNIT" ;;
    status)  systemctl --user status "$UNIT" ;;
    logs)    journalctl --user -u "$UNIT" -f ;;
    attach)  cmd_attach ;;
    list)    cmd_list ;;
  esac
}

# Allow tests to source helpers without running main.
if [ "${WAKE_CLAUDE_SOURCE_ONLY:-0}" = "1" ]; then
  return 0 2>/dev/null || exit 0
fi

main "$@"
